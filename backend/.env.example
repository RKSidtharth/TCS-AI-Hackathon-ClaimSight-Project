# CLAIMSIGHT AI - Environment Configuration Example

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JWT
JWT_SECRET=claimsight_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=claimsight_ai

# File Storage Configuration (local or s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# External AI Provider (Optional - deterministic offline fallback active if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=

# External Weather Provider (Optional - verified historical weather fallback active if unset)
WEATHER_API_KEY=

# Telematics & External Benchmark Settings
TELEMATICS_ENABLED=true
ENABLE_SYNTHETIC_BENCHMARKS=true

